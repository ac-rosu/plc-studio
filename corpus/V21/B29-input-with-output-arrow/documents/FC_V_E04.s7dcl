{
    S7_EditorMode := "SCL";
    S7_Optimized := "TRUE";
    S7_Version := "0.1"
}
FUNCTION "FC_V_E04" : Void
    VAR_TEMP
        x : Int;
        y : Int;
    END_VAR

    { S7_Language := "SCL" }
    NETWORK
        
            "FC_V_Callee"(InValue => #x, OutValue => #y);
        
    END_NETWORK
END_FUNCTION
