{
    S7_EditorMode := "SCL";
    S7_Optimized := "TRUE";
    S7_Version := "0.1"
}
FUNCTION "FC_AnaForCounter_Direct" : Int
    VAR_INPUT
        { S7_MLC := "MLC_3Jx" }
        "Limit" : Int;
    END_VAR
    VAR_TEMP
        { S7_MLC := "MLC_mQ" }
        Index : Int;
        { S7_MLC := "MLC_3pN" }
        Total : Int;
    END_VAR

    { S7_Language := "SCL" }
    NETWORK
        
            #Total := 0;
            FOR #Index := 0 TO 10 DO
                #Total := #Total + #Index;
                IF #Total > #Limit THEN
                    #Index := 10;
                END_IF;
            END_FOR;
            #FC_AnaForCounter_Direct := #Total;
        
    END_NETWORK
END_FUNCTION
