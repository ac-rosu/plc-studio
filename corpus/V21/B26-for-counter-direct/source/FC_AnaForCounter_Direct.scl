FUNCTION "FC_AnaForCounter_Direct" : Int
TITLE = Analyzer rule C26h, refused by TIA
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
//C26h as first written: the FOR counter Index is assigned directly inside the loop; TIA refuses this
   VAR_INPUT 
      Limit : Int;   // Stop when the total exceeds this
   END_VAR

   VAR_TEMP 
      Index : Int;   // Loop counter
      Total : Int;   // Sum of the indices
   END_VAR


BEGIN
	
	    #Total := 0;
	    FOR #Index := 0 TO 10 DO
	        #Total := #Total + #Index;
	        IF #Total > #Limit THEN
	            #Index := 10;
	        END_IF;
	    END_FOR;
	    #FC_AnaForCounter_Direct := #Total;
	
END_FUNCTION

