{
    S7_EditorMode := "SCL";
    S7_Optimized := "TRUE";
    S7_Version := "0.1"
}
FUNCTION_BLOCK "FB_SclCalls_B05"
    VAR_INPUT
        { S7_MLC := "MLC_4dx" }
        Enable : Bool;
        { S7_MLC := "MLC_449" }
        Mode : Int;
        { S7_MLC := "MLC_Ny" }
        Delta : Real;
    END_VAR
    VAR_OUTPUT
        { S7_MLC := "MLC_by" }
        Average : Real;
        { S7_MLC := "MLC_43P" }
        Scaled : Real;
        { S7_MLC := "MLC_4rC" }
        CallsOk : Bool;
    END_VAR
    VAR_IN_OUT
        { S7_MLC := "MLC_QR" }
        TimerBlock : _.FB_SclTimers;
        { S7_MLC := "MLC_3LP" }
        Values : Array[0..9] of Real;
    END_VAR
    VAR
        { S7_MLC := "MLC_4nA" }
        Sections : _.FB_SclSections;
        { S7_MLC := "MLC_4RQ" }
        Total : LReal;
        { S7_MLC := "MLC_4Rb" }
        Rounded : DInt;
        { S7_MLC := "MLC_ip" }
        ResultText : String;
        { S7_MLC := "MLC_3yd" }
        Magnitude : Real;
        { S7_MLC := "MLC_4i9" }
        ConvertedWord : Word;
        { S7_MLC := "MLC_3ri" }
        IntValue : Int;
        { S7_MLC := "MLC_3T7" }
        ShortValue : SInt;
        { S7_MLC := "MLC_42s" }
        NarrowValue : Int;
    END_VAR
    VAR_TEMP
        { S7_MLC := "MLC_4iR" }
        CallOk : Bool;
    END_VAR

    { S7_Language := "SCL" }
    NETWORK
        
            REGION Multi-instance call, formal parameter list
                #Sections(Enable := #Enable,
                          Mode := #Mode,
                          Setpoint := 100.0,
                          Result => #Average);
            END_REGION
            
            REGION Single-instance call with an instance DB
                "IDB_SclSections"(Enable := #Enable, Mode := 2, Values := #Values);
            END_REGION
            
            REGION Parameter instance
                #TimerBlock(Start := #Enable, Reset := NOT #Enable);
            END_REGION
            
            REGION FC calls with Input, Output and InOut, ENO
                #Scaled := "FC_SclTypes"(InInt := #Mode,
                                         InReal := #Delta,
                                         OutDInt => #Rounded,
                                         OutText => #ResultText,
                                         Accumulator := #Total,
                                         ENO => #CallOk);
                #ConvertedWord := "FC_IecOff"(InInt := #Mode, InWord := 16#00FF, InDInt := 1000, OutInt => #IntValue, OutSInt => #ShortValue, OutNarrow => #NarrowValue);
            END_REGION
            
            REGION Non-formal parameter list
                #Magnitude := ABS(#Delta);
            END_REGION
            
            #CallsOk := #CallOk;
            ENO := #CallOk;
        
    END_NETWORK
END_FUNCTION_BLOCK
