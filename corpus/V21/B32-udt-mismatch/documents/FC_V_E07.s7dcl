{
    S7_EditorMode := "SCL";
    S7_Optimized := "TRUE";
    S7_Version := "0.1"
}
FUNCTION "FC_V_E07" : Void
    VAR_TEMP
        "a" : _.UDT_Motor;
        "b" : _.UDT_Recipe;
    END_VAR

    { S7_Language := "SCL" }
    NETWORK
        
            #a := #b;
        
    END_NETWORK
END_FUNCTION
