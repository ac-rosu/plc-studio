{
    S7_EditorMode := "SCL";
    S7_Optimized := "TRUE";
    S7_Version := "0.1"
}
FUNCTION_BLOCK "FB_SclTimers"
    VAR_INPUT
        { S7_MLC := "MLC_yV" }
        Start : Bool;
        { S7_MLC := "MLC_3bG" }
        Reset : Bool;
        { S7_MLC := "MLC_49r" }
        DelayTime : Time := T#2S;
    END_VAR
    VAR_OUTPUT
        { S7_MLC := "MLC_48Y" }
        DelayedOn : Bool;
        { S7_MLC := "MLC_4u3" }
        RunOn : Bool;
        { S7_MLC := "MLC_3Bm" }
        Pulse : Bool;
        { S7_MLC := "MLC_TG" }
        Count : Int;
        { S7_MLC := "MLC_4Nn" }
        CountReached : Bool;
    END_VAR
    VAR
        { S7_MLC := "MLC_4tM" }
        OnDelay : TON_TIME;
        { S7_MLC := "MLC_3qB" }
        OffDelay : TOF_TIME;
        { S7_MLC := "MLC_3kK" }
        PulseTimer : TP_TIME;
        { S7_MLC := "MLC_4QL" }
        StartEdge : R_TRIG;
        { S7_MLC := "MLC_4in" }
        StopEdge : F_TRIG;
        { S7_MLC := "MLC_4vE" }
        PartCounter : CTU_INT;
    END_VAR
    VAR CONSTANT
        { S7_MLC := "MLC_3ia" }
        COUNT_PRESET : Int := 10;
    END_VAR

    { S7_Language := "SCL" }
    NETWORK
        
            REGION Timers
                #OnDelay(IN := #Start, PT := #DelayTime, Q => #DelayedOn);
                #OffDelay(IN := #Start, PT := T#3s, Q => #RunOn);
            END_REGION
            
            REGION Edges and pulse
                #StartEdge(CLK := #Start);
                #StopEdge(CLK := #Start);
                #PulseTimer(IN := #StartEdge.Q, PT := T#500ms, Q => #Pulse);
            END_REGION
            
            REGION Counter
                #PartCounter(CU := #StopEdge.Q, R := #Reset, PV := #COUNT_PRESET, Q => #CountReached, CV => #Count);
            END_REGION
        
    END_NETWORK
END_FUNCTION_BLOCK
