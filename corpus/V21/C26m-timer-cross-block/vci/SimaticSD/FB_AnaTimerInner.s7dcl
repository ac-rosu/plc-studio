{
    S7_EditorMode := "SCL";
    S7_Optimized := "TRUE";
    S7_Version := "0.1"
}
FUNCTION_BLOCK "FB_AnaTimerInner"
    VAR_INPUT
        { S7_MLC := "MLC_3vG" }
        Start : Bool;
    END_VAR
    VAR_OUTPUT
        { S7_MLC := "MLC_4wL" }
        Done : Bool;
    END_VAR
    VAR
        { S7_MLC := "MLC_3Ta" }
        Delay : TON_TIME;
    END_VAR

    { S7_Language := "SCL" }
    NETWORK
        
            #Delay(IN := #Start, PT := T#2s);
            #Done := #Delay.Q;
        
    END_NETWORK
END_FUNCTION_BLOCK
