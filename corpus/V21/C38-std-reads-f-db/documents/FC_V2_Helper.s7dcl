{
    S7_Optimized := "TRUE";
    S7_PreferredLanguage := "LAD";
    S7_Version := "0.1"
}
FUNCTION "FC_V2_Helper" : Void
    VAR_INPUT
        Request : Bool;
    END_VAR
    VAR_OUTPUT
        Granted : Bool;
    END_VAR

    { S7_Language := "LAD" }
    NETWORK
        RUNG wire#powerrail
            Contact( #Request )
            Coil( #Granted )
        END_RUNG
    END_NETWORK
END_FUNCTION
