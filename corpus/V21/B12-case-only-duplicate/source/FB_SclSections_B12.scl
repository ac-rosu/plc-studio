FUNCTION_BLOCK "FB_SclSections_B12"
TITLE = SCL sections and control statements
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
//Uses every interface section and every SCL control statement
   VAR_INPUT 
      Enable : Bool;   // Enable the evaluation
      Mode : Int;   // Mode: 0 = off, 1 = manual, 2..5 = automatic
      Setpoint : Real;   // Setpoint for the "sum" check
   END_VAR

   VAR_OUTPUT 
      Busy : Bool;   // Evaluation is running
      Result : Real;   // Average of the 'valid' values
      StepCount : Int;   // Number of steps # executed
   END_VAR

   VAR_IN_OUT 
      Values : Array[0..9] of Real;   // Measured values & limits
   END_VAR

   VAR 
      State : Int;   // State of the evaluation
      state_1 : Int;   // Second member whose name differs only by case
      Sum : Real;   // Running sum
      Iterations : Int;   // Loop iterations of the last call
   END_VAR

   VAR_TEMP 
      Index : Int;   // Loop index
      Guard : Int;   // Loop guard
      Average : Real;   // Calculated average
   END_VAR

   VAR CONSTANT 
      MAXIMUM_INDEX : Int := 9;   // Highest array index
      MAXIMUM_ITERATIONS : Int := 100;   // Loop limit
      STATE_IDLE : Int := 0;   // Idle state
      STATE_RUN : Int := 10;   // Running state
      LIMIT_VALUE : Real := 1000.0;   // Upper limit for a single value
   END_VAR


BEGIN
	
	    REGION Input processing
	        // Reset the outputs when the block is disabled
	        IF NOT #Enable THEN
	            #Busy := FALSE;
	            #State := #STATE_IDLE;
	        ELSIF #Mode = 1 THEN
	            #Busy := TRUE;
	        ELSE
	            #Busy := #Mode > 1;
	        END_IF;
	    END_REGION
	    
	    REGION State machine
	        CASE #Mode OF
	            0:
	                #State := #STATE_IDLE;
	            1:
	                #State := #STATE_RUN;
	            2..5:
	                #State := #STATE_RUN + #Mode;
	            ELSE
	                #State := #STATE_IDLE;
	        END_CASE;
	    END_REGION
	    
	    REGION Loops
	        (* Sum all valid values: skip negative values and stop at the limit *)
	        #Sum := 0.0;
	        #Iterations := 0;
	        FOR #Index := 0 TO #MAXIMUM_INDEX DO
	            IF #Values[#Index] < 0.0 THEN
	                CONTINUE;
	            END_IF;
	            IF #Values[#Index] > #LIMIT_VALUE THEN
	                EXIT;
	            END_IF;
	            #Sum := #Sum + #Values[#Index];
	            #Iterations := #Iterations + 1;
	        END_FOR;
	        
	        // Reduce the sum to the setpoint, bounded by a guard
	        #Guard := 0;
	        WHILE (#Sum > #Setpoint) AND (#Guard < #MAXIMUM_ITERATIONS) DO
	            #Sum := #Sum - 1.0;
	            #Guard := #Guard + 1;
	        END_WHILE;
	        
	        #Guard := 0;
	        REPEAT
	            #Guard := #Guard + 1;
	        UNTIL (#Guard >= #MAXIMUM_ITERATIONS) OR (#Sum >= 0.0)
	        END_REPEAT;
	    END_REGION
	    
	    REGION Outputs
	        IF #Iterations > 0 THEN
	            #Average := #Sum / INT_TO_REAL(#Iterations);
	        ELSE
	            #Average := 0.0;
	        END_IF;
	        #Result := #Average;
	        #StepCount := #Iterations;
	    END_REGION
	
END_FUNCTION_BLOCK

