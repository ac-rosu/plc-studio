NAMESPACE Dosing
FUNCTION_BLOCK "FB_Doser_B21"
{ S7_Optimized_Access := 'TRUE' ; Published := 'FALSE' }
VERSION : 0.1
   VAR_INPUT 
      Start : Bool;   // Start dosing
      Stop : Bool;   // Stop dosing
   END_VAR

   VAR_OUTPUT 
      Dosing : Bool;   // Dosing is running
      Done : Bool;   // Dosing finished
   END_VAR

   VAR 
      Filler : _.Filling.FB_Filler;   // Filler of the unit Filling
      Recipe : _.Filling.UDT_FillRecipe;   // Recipe of the unit Filling
   END_VAR


BEGIN
	
	    REGION Dosing through the filler
	        #Recipe.TargetVolume := _.Filling.FC_FillHelper(RawFlow := 50, Factor := 0.01);
	        #Filler(Start := #Start, Stop := #Stop, Recipe := #Recipe);
	        #Dosing := #Filler.Filling;
	        #Done := #Filler.Done;
	    END_REGION
	
END_FUNCTION_BLOCK
END_NAMESPACE

