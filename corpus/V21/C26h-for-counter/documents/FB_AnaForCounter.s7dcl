{
    S7_EditorMode := "SCL";
    S7_Optimized := "TRUE";
    S7_Version := "0.1"
}
FUNCTION_BLOCK "FB_AnaForCounter"
    VAR_INPUT
        { S7_MLC := "MLC_3xz" }
        "Limit" : Int;
    END_VAR
    VAR_OUTPUT
        { S7_MLC := "MLC_wi" }
        Total : Int;
    END_VAR
    VAR
        { S7_MLC := "MLC_3AK" }
        Index : Int;
    END_VAR
    VAR_TEMP
        { S7_MLC := "MLC_4Bn" }
        IndexRef : REF_TO Int;
    END_VAR

    { S7_Language := "SCL" }
    NETWORK
        
            #Total := 0;
            #IndexRef := REF(#Index);
            FOR #Index := 0 TO 10 DO
                #Total := #Total + #Index;
                IF #Total > #Limit THEN
                    #IndexRef^ := 10;
                END_IF;
            END_FOR;
        
    END_NETWORK
END_FUNCTION_BLOCK
