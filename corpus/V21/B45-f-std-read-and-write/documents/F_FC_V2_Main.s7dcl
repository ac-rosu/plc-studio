{
    S7_Optimized := "TRUE";
    S7_PreferredLanguage := "LAD";
    S7_Safety := "TRUE";
    S7_Version := "0.1"
}
FUNCTION "F_FC_V2_Main" : Void
    VAR_TEMP
        FromDb : Bool;
        FromTag : Bool;
        FromInput : Bool;
        Level : Bool;
    END_VAR

    { S7_Language := "LAD" }
    NETWORK
        RUNG wire#powerrail
            "F_FC_V2_StdData"(
                Request := TRUE,
                FromDb => #FromDb,
                FromTag => #FromTag,
                FromInput => #FromInput
            )
        END_RUNG
    END_NETWORK
    { S7_Language := "LAD" }
    NETWORK
        RUNG wire#powerrail
            "F_FC_V2_StdOk"(Level => #Level)
        END_RUNG
    END_NETWORK
END_FUNCTION
