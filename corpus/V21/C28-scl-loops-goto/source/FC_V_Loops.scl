FUNCTION "FC_V_Loops" : Int
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_INPUT 
      Limit : Int;
   END_VAR

   VAR_TEMP 
      Index : Int;
      Sum : Int;
   END_VAR


BEGIN
	
	    #Sum := 0;
	    FOR #Index := 10 TO 0 BY -2 DO
	        #Sum := #Sum + #Index;
	    END_FOR;
	    IF #Sum > #Limit THEN
	        GOTO Finish;
	    END_IF;
	    #Sum := #Sum * 2;
	    IF #Limit < 0 THEN
	        #FC_V_Loops := 0;
	        RETURN;
	    END_IF;
	    Finish: #FC_V_Loops := #Sum;
	
END_FUNCTION

