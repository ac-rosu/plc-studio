{
    S7_EditorMode := "SCL";
    S7_Optimized := "TRUE";
    S7_Version := "0.1"
}
FUNCTION_BLOCK "FB_SclCalls_B06"
    VAR_INPUT
        { S7_MLC := "MLC_3QV" }
        Enable : Bool;
        { S7_MLC := "MLC_4Uz" }
        Mode : Int;
        { S7_MLC := "MLC_3PG" }
        Delta : Real;
    END_VAR
    VAR_OUTPUT
        { S7_MLC := "MLC_4qg" }
        Average : Real;
        { S7_MLC := "MLC_323" }
        Scaled : Real;
        { S7_MLC := "MLC_3f8" }
        CallsOk : Bool;
    END_VAR
    VAR_IN_OUT
        { S7_MLC := "MLC_3hU" }
        TimerBlock : _.FB_SclTimers;
        { S7_MLC := "MLC_iz" }
        Values : Array[0..9] of Real;
    END_VAR
    VAR
        { S7_MLC := "MLC_3UX" }
        Sections : _.FB_SclSections;
        { S7_MLC := "MLC_Sp" }
        Total : LReal;
        { S7_MLC := "MLC_54j" }
        Rounded : DInt;
        { S7_MLC := "MLC_32G" }
        ResultText : String;
        { S7_MLC := "MLC_4Zd" }
        Magnitude : Real;
        { S7_MLC := "MLC_4XR" }
        ConvertedWord : Word;
        { S7_MLC := "MLC_Qe" }
        IntValue : Int;
        { S7_MLC := "MLC_4X6" }
        ShortValue : SInt;
        { S7_MLC := "MLC_38E" }
        NarrowValue : Int;
    END_VAR
    VAR_TEMP
        { S7_MLC := "MLC_3pW" }
        CallOk : Bool;
    END_VAR

    { S7_Language := "SCL" }
    NETWORK
        
            REGION Multi-instance call, formal parameter list
                #Sections(Enable := #Enable,
                          Mode := #Mode,
                          Setpoint := 100.0,
                          Result => #Average,
                          Values := #Values);
            END_REGION
            
            REGION Single-instance call with an instance DB
                "IDB_SclSections"(Enable := #Enable, Mode := 2, Values := #Values);
            END_REGION
            
            REGION Parameter instance
                #TimerBlock(Start := #Enable, Reset := NOT #Enable);
            END_REGION
            
            REGION FC calls with Input, Output and InOut, ENO
                #Scaled := "FC_SclTypes"(InInt := #Mode,
                                         InReal := #Delta,
                                         OutDInt => #Rounded,
                                         OutText => #ResultText,
                                         Accumulator := #Total,
                                         ENO => #CallOk);
                #ConvertedWord := "FC_IecMissing"(InInt := #Mode, InWord := 16#00FF, InDInt := 1000, OutInt => #IntValue, OutSInt => #ShortValue, OutNarrow => #NarrowValue);
            END_REGION
            
            REGION Non-formal parameter list
                #Magnitude := ABS(#Delta);
            END_REGION
            
            #CallsOk := #CallOk;
            ENO := #CallOk;
        
    END_NETWORK
END_FUNCTION_BLOCK
