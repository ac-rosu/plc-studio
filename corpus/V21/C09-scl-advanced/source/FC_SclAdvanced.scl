FUNCTION "FC_SclAdvanced" : Int
TITLE = Advanced SCL constructs
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
//VARIANT, references, DB_ANY, Array[*], strings and nested structs; the AT overlay is in FC_SclAtOverlay
   VAR_INPUT 
      AnyValue : Variant;   // Value of any type
      DataBlock : DB_ANY;   // Any data block
      Text : String;   // Input text
   END_VAR

   VAR_OUTPUT 
      TextLength : Int;   // Length of the combined text
      DbNumber : UInt;   // Number of the data block
   END_VAR

   VAR_IN_OUT 
      Samples : Array[*] of Int;   // Samples of any length
   END_VAR

   VAR_TEMP 
      Index : DInt;   // Loop index
      Total : DInt;   // Sum of the samples
      TypeCode : Int;   // Code of the data type behind AnyValue
      Measurement : Struct   // Nested structure
         Header : Struct   // Header of the measurement
            Id : Int;   // Measurement number
            Label : String[10];   // Short label
         END_STRUCT;
         Value : Real;   // Measured value
      END_STRUCT;
      Combined : String[40];   // Combined text
      Position : Int;   // Position of a substring
      TemperatureRef : REF_TO Real;   // Reference to a temperature
   END_VAR


BEGIN
	
	    REGION Variant
	        CASE TypeOf(#AnyValue) OF
	            Int:
	                #TypeCode := 1;
	            Real:
	                #TypeCode := 2;
	            ELSE
	                #TypeCode := 0;
	        END_CASE;
	    END_REGION
	    
	    REGION Reference
	        #TemperatureRef := REF("DB_Machine".Temperature);
	        IF #TemperatureRef <> NULL THEN
	            #TemperatureRef^ := #TemperatureRef^ + 0.1;
	        END_IF;
	    END_REGION
	    
	    REGION Data block
	        #DbNumber := DB_ANY_TO_UINT(#DataBlock);
	    END_REGION
	    
	    REGION Array of any length
	        #Total := 0;
	        FOR #Index := LOWER_BOUND(ARR := #Samples, DIM := 1) TO UPPER_BOUND(ARR := #Samples, DIM := 1) DO
	            #Total := #Total + #Samples[#Index];
	        END_FOR;
	    END_REGION
	    
	    REGION Strings and nested structs
	        #Measurement.Header.Id := 7;
	        #Measurement.Header.Label := LEFT(IN := #Text, L := 10);
	        #Measurement.Value := DINT_TO_REAL(#Total);
	        #Combined := CONCAT(IN1 := #Measurement.Header.Label, IN2 := '-OK');
	        #Position := FIND(IN1 := #Combined, IN2 := 'OK');
	        #TextLength := LEN(#Combined);
	    END_REGION
	    
	    #FC_SclAdvanced := #TypeCode;
	
END_FUNCTION

