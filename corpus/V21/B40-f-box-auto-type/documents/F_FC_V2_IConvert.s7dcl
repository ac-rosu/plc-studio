{
    S7_Optimized := "TRUE";
    S7_PreferredLanguage := "LAD";
    S7_Safety := "TRUE";
    S7_Version := "0.1"
}
FUNCTION "F_FC_V2_IConvert" : Void
    VAR_INPUT
        X1 : Int;
    END_VAR
    VAR_OUTPUT
        "D" : DInt;
    END_VAR

    { S7_Language := "LAD" }
    NETWORK
        RUNG wire#powerrail
            Convert(
                in := #X1,
                out => #"D"
            )
        END_RUNG
    END_NETWORK
END_FUNCTION
