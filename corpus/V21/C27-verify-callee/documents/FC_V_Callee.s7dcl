{
    S7_EditorMode := "SCL";
    S7_Optimized := "TRUE";
    S7_Version := "0.1"
}
FUNCTION "FC_V_Callee" : Void
    VAR_INPUT
        InValue : Int;
    END_VAR
    VAR_OUTPUT
        OutValue : Int;
    END_VAR

    { S7_Language := "SCL" }
    NETWORK
        
            #OutValue := #InValue + 1;
        
    END_NETWORK
END_FUNCTION
