{
    S7_EditorMode := "SCL";
    S7_Optimized := "TRUE";
    S7_Version := "0.1"
}
FUNCTION_BLOCK "FB_AnaStatusIgnored"
    VAR
        { S7_MLC := "MLC_3NV" }
        Now : DTL;
    END_VAR
    VAR_TEMP
        { S7_MLC := "MLC_3nA" }
        RetVal : Int;
    END_VAR

    { S7_Language := "SCL" }
    NETWORK
        
            #RetVal := RD_LOC_T(OUT => #Now);
        
    END_NETWORK
END_FUNCTION_BLOCK
