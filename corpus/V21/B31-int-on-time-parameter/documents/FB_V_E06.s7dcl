FUNCTION_BLOCK "FB_V_E06"
    VAR
        Delay : TON_TIME;
    END_VAR
    VAR_TEMP
        "p" : Int;
    END_VAR

    { S7_Language := "SCL" }
    NETWORK
        
            #Delay(IN := TRUE, PT := #p);
        
    END_NETWORK
END_FUNCTION_BLOCK
