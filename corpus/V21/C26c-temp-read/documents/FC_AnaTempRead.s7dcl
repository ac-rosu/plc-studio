{
    S7_EditorMode := "SCL";
    S7_Optimized := "TRUE";
    S7_Version := "0.1"
}
FUNCTION "FC_AnaTempRead" : Int
    VAR_INPUT
        { S7_MLC := "MLC_3bx" }
        Value : Int;
    END_VAR
    VAR_TEMP
        { S7_MLC := "MLC_4Ah" }
        Sum : Int;
    END_VAR

    { S7_Language := "SCL" }
    NETWORK
        
            #Sum := #Sum + #Value;
            #FC_AnaTempRead := #Sum;
        
    END_NETWORK
END_FUNCTION
