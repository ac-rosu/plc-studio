{
  "name": "plc-studio-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/core",
    "packages/profiles",
    "packages/language-server",
    "packages/webviews",
    "packages/extension",
    "tools/corpus-harness"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc -p tsconfig.json && npm run typecheck --workspaces --if-present",
    "test": "vitest run --project unit",
    "test:corpus": "vitest run --project corpus",
    "test:web": "vitest run --project web",
    "corpus:report": "node tools/corpus-harness/src/cli.ts",
    "package": "npm run package -w plcstudio",
    "corpus:inspect": "node tools/corpus-harness/src/inspect.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "@vitest/browser": "5.0.5",
    "@vitest/browser-playwright": "5.0.5",
    "@vscode/vsce": "4.0.0",
    "ajv": "8.20.0",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "playwright": "1.64.1",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
