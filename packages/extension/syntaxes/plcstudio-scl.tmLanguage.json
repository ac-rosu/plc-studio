{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "SCL (PLC Studio)",
  "scopeName": "source.plcstudio-scl",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#attributes"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#names"
    },
    {
      "name": "keyword.control.plcstudio",
      "match": "(?i)\\b(IF|THEN|ELSIF|ELSE|END_IF|CASE|OF|END_CASE|FOR|TO|BY|DO|END_FOR|WHILE|END_WHILE|REPEAT|UNTIL|END_REPEAT|EXIT|CONTINUE|RETURN|GOTO|REGION|END_REGION)\\b"
    },
    {
      "name": "keyword.other.block.plcstudio",
      "match": "(?i)\\b(FUNCTION_BLOCK|END_FUNCTION_BLOCK|FUNCTION|END_FUNCTION|ORGANIZATION_BLOCK|END_ORGANIZATION_BLOCK|DATA_BLOCK|END_DATA_BLOCK|TYPE|END_TYPE|NAMESPACE|END_NAMESPACE|BEGIN|TITLE|VERSION|AUTHOR|FAMILY|NAME|NON_RETAIN|KNOW_HOW_PROTECT)\\b"
    },
    {
      "name": "keyword.other.declaration.plcstudio",
      "match": "(?i)\\b(VAR_INPUT|VAR_OUTPUT|VAR_IN_OUT|VAR_TEMP|VAR_STAT|VAR|END_VAR|CONSTANT|RETAIN|DB_SPECIFIC|STRUCT|END_STRUCT|ARRAY|AT|REF_TO)\\b"
    },
    {
      "name": "keyword.operator.word.plcstudio",
      "match": "(?i)\\b(AND|OR|XOR|NOT|MOD)\\b"
    },
    {
      "name": "storage.type.plcstudio",
      "match": "(?i)\\b(Bool|Byte|Word|DWord|LWord|SInt|USInt|Int|UInt|DInt|UDInt|LInt|ULInt|Real|LReal|Time|LTime|S5Time|Date|Time_Of_Day|TOD|LTime_Of_Day|LTOD|Date_And_Time|DT|LDT|DTL|Char|WChar|String|WString|Variant|DB_ANY|Void|Any|Pointer|TON_TIME|TOF_TIME|TP_TIME|TONR_TIME|IEC_TIMER|IEC_COUNTER|CTU_INT|CTU_DINT|CTD_INT|CTUD_INT|R_TRIG|F_TRIG)\\b"
    },
    {
      "name": "keyword.operator.plcstudio",
      "match": ":=|=>|<=|>=|<>|\\*\\*|[-+*/<>=&^]"
    },
    {
      "name": "support.function.plcstudio",
      "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?=\\s*\\()"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.plcstudio",
          "match": "//.*$"
        },
        {
          "name": "comment.block.plcstudio",
          "begin": "\\(\\*",
          "end": "\\*\\)"
        },
        {
          "name": "comment.block.plcstudio",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.single.plcstudio",
          "begin": "'",
          "end": "'|$",
          "patterns": [
            {
              "name": "constant.character.escape.plcstudio",
              "match": "\\$."
            }
          ]
        },
        {
          "name": "constant.other.typed-literal.plcstudio",
          "match": "(?i)\\b(?:T|TIME|LT|LTIME|S5T|S5TIME|D|DATE|TOD|TIME_OF_DAY|LTOD|DT|DATE_AND_TIME|LDT|DTL)#[-+0-9A-Za-z_.:]+"
        },
        {
          "name": "constant.numeric.plcstudio",
          "match": "(?i)\\b(?:[A-Z_]+#)?(?:\\d+#[0-9A-F_]+|\\d[\\d_]*(?:\\.\\d[\\d_]*)?(?:E[-+]?\\d+)?)\\b"
        },
        {
          "name": "constant.language.plcstudio",
          "match": "(?i)\\b(TRUE|FALSE|NULL)\\b"
        }
      ]
    },
    "names": {
      "patterns": [
        {
          "name": "variable.other.local.plcstudio",
          "match": "#(?:\"[^\"]*\"|[A-Za-z_][A-Za-z0-9_]*)"
        },
        {
          "name": "variable.other.global.plcstudio",
          "match": "\"[^\"\\r\\n]*\""
        },
        {
          "name": "variable.other.address.plcstudio",
          "match": "%[A-Za-z]+[0-9.]*"
        }
      ]
    },
    "attributes": {
      "name": "meta.attribute.plcstudio",
      "begin": "\\{",
      "end": "\\}",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.attribute.plcstudio"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.attribute.plcstudio"
        }
      },
      "patterns": [
        {
          "name": "entity.other.attribute-name.plcstudio",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?=\\s*:=)"
        },
        {
          "name": "string.quoted.double.plcstudio",
          "match": "\"[^\"]*\""
        },
        {
          "name": "string.quoted.single.plcstudio",
          "match": "'[^']*'"
        },
        {
          "name": "keyword.operator.plcstudio",
          "match": ":="
        }
      ]
    }
  }
}
