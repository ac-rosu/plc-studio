# Allowlist: everything is excluded except the files the extension needs at run time.
# scripts/package.mts checks the result.
**
!package.json
!README.md
!CHANGELOG.md
!LICENSE
!images/icon.png
!schemas/*.schema.json
!syntaxes/*.json
!language-configuration.json
!dist/extension.js
!dist/server.js
!dist/webviews/*.js
!dist/webviews/*.css
