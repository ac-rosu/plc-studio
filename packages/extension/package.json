{
  "name": "plcstudio",
  "displayName": "PLC Studio",
  "description": "SCL, LAD and FBD editing, checking and analysis for SIMATIC S7-1200/1500 programs exported from TIA Portal V21. Works on files only: no connection to TIA, no telemetry.",
  "version": "0.1.0",
  "publisher": "acro",
  "license": "MIT",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/ac-rosu/plc-studio.git"
  },
  "bugs": {
    "url": "https://github.com/ac-rosu/plc-studio/issues"
  },
  "homepage": "https://github.com/ac-rosu/plc-studio#readme",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Formatters"
  ],
  "keywords": [
    "scl",
    "lad",
    "fbd",
    "plc",
    "s7-1200",
    "s7-1500",
    "structured control language",
    "ladder logic",
    "function block diagram",
    "iec 61131-3",
    "industrial automation",
    "plc programming",
    "s7dcl",
    "fail-safe",
    "static analysis"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "plcstudio-scl",
        "aliases": [
          "SCL (PLC Studio)"
        ],
        "extensions": [
          ".scl",
          ".udt",
          ".db"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "plcstudio-s7dcl",
        "aliases": [
          "SD Document (PLC Studio)"
        ],
        "extensions": [
          ".s7dcl"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "plcstudio-s7res",
        "aliases": [
          "SD Resources (PLC Studio)"
        ],
        "extensions": [
          ".s7res"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "plcstudio-tagtable",
        "aliases": [
          "Tag Table (PLC Studio)"
        ],
        "filenamePatterns": [
          "**/PLC tags/**/*.xml"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "jsonValidation": [
      {
        "fileMatch": "plc.json",
        "url": "./schemas/plc.schema.json"
      },
      {
        "fileMatch": "plcstudio.rules.json",
        "url": "./schemas/rules.schema.json"
      }
    ],
    "grammars": [
      {
        "language": "plcstudio-scl",
        "scopeName": "source.plcstudio-scl",
        "path": "./syntaxes/plcstudio-scl.tmLanguage.json"
      },
      {
        "language": "plcstudio-s7dcl",
        "scopeName": "source.plcstudio-s7dcl",
        "path": "./syntaxes/plcstudio-s7dcl.tmLanguage.json"
      },
      {
        "language": "plcstudio-s7res",
        "scopeName": "source.plcstudio-s7res",
        "path": "./syntaxes/plcstudio-s7res.tmLanguage.json"
      },
      {
        "language": "plcstudio-tagtable",
        "scopeName": "text.xml.plcstudio-tagtable",
        "path": "./syntaxes/plcstudio-tagtable.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "plcstudio.createManifest",
        "title": "Create manifest",
        "category": "PLC Studio"
      },
      {
        "command": "plcstudio.showProfileCoverage",
        "title": "Show profile coverage",
        "category": "PLC Studio"
      },
      {
        "command": "plcstudio.restartServer",
        "title": "Restart language server",
        "category": "PLC Studio"
      },
      {
        "command": "plcstudio.useForPlcFiles",
        "title": "Use PLC Studio for PLC files",
        "category": "PLC Studio"
      },
      {
        "command": "plcstudio.openLadderView",
        "title": "Open LAD/FBD View",
        "category": "PLC Studio",
        "icon": "$(circuit-board)"
      },
      {
        "command": "plcstudio.traceValue",
        "title": "Trace value",
        "category": "PLC Studio"
      },
      {
        "command": "plcstudio.refreshCallTree",
        "title": "Refresh call tree",
        "category": "PLC Studio",
        "icon": "$(refresh)"
      },
      {
        "command": "plcstudio.toggleCallTreeInstructions",
        "title": "Show or hide instructions in the call tree",
        "category": "PLC Studio",
        "icon": "$(symbol-operator)"
      },
      {
        "command": "plcstudio.clearTrace",
        "title": "Clear trace",
        "category": "PLC Studio",
        "icon": "$(clear-all)"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "plcstudio.createManifest",
          "when": "explorerResourceIsFolder",
          "group": "plcstudio"
        },
        {
          "command": "plcstudio.openLadderView",
          "when": "resourceExtname == .s7dcl",
          "group": "navigation"
        }
      ],
      "editor/title": [
        {
          "command": "plcstudio.openLadderView",
          "when": "resourceExtname == .s7dcl && activeCustomEditorId != plcstudio.ladderEditor",
          "group": "navigation"
        }
      ],
      "view/title": [
        {
          "command": "plcstudio.refreshCallTree",
          "when": "view == plcstudio.callTree",
          "group": "navigation@1"
        },
        {
          "command": "plcstudio.toggleCallTreeInstructions",
          "when": "view == plcstudio.callTree",
          "group": "navigation@2"
        },
        {
          "command": "plcstudio.clearTrace",
          "when": "view == plcstudio.trace",
          "group": "navigation@1"
        }
      ],
      "editor/context": [
        {
          "command": "plcstudio.traceValue",
          "when": "editorLangId =~ /^plcstudio-(scl|s7dcl)$/",
          "group": "navigation@90"
        }
      ],
      "commandPalette": [
        {
          "command": "plcstudio.refreshCallTree",
          "when": "false"
        },
        {
          "command": "plcstudio.toggleCallTreeInstructions",
          "when": "false"
        },
        {
          "command": "plcstudio.clearTrace",
          "when": "false"
        },
        {
          "command": "plcstudio.traceValue",
          "when": "editorLangId =~ /^plcstudio-(scl|s7dcl)$/"
        }
      ]
    },
    "configuration": {
      "title": "PLC Studio",
      "properties": {
        "plcstudio.ladder.editing": {
          "type": "boolean",
          "default": true,
          "description": "Allow editing in the LAD/FBD view (palette, drag and drop, operands, networks). Every edit changes only the lines of the affected network."
        },
        "plcstudio.displayLanguage": {
          "type": "string",
          "default": "",
          "pattern": "^([a-z]{2,3}-[A-Z]{2})?$",
          "markdownDescription": "Language of the comments and titles shown inline, for example `de-DE`. Empty: the `displayLanguage` of `plc.json`."
        }
      }
    },
    "configurationDefaults": {
      "[plcstudio-scl]": {
        "editor.formatOnSaveMode": "modifications",
        "editor.semanticHighlighting.enabled": true
      },
      "[plcstudio-s7dcl]": {
        "editor.formatOnSaveMode": "modifications",
        "editor.semanticHighlighting.enabled": true
      }
    },
    "customEditors": [
      {
        "viewType": "plcstudio.ladderEditor",
        "displayName": "LAD/FBD View (PLC Studio)",
        "selector": [
          {
            "filenamePattern": "*.s7dcl"
          }
        ],
        "priority": "option"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "plcstudio",
          "title": "PLC Studio",
          "icon": "images/activity.svg"
        }
      ]
    },
    "views": {
      "plcstudio": [
        {
          "id": "plcstudio.callTree",
          "name": "Call tree",
          "contextualTitle": "PLC Studio"
        },
        {
          "id": "plcstudio.trace",
          "name": "Trace value",
          "contextualTitle": "PLC Studio"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "plcstudio.callTree",
        "contents": "No PLC folder with a plc.json in this workspace.\n[Create manifest](command:plcstudio.createManifest)"
      },
      {
        "view": "plcstudio.trace",
        "contents": "Place the cursor on a variable, tag or data block member and run Trace value to see every read and write across blocks.\n[Trace value](command:plcstudio.traceValue)"
      }
    ]
  },
  "scripts": {
    "build": "node scripts/build.mts",
    "typecheck": "tsc -p tsconfig.json",
    "package": "node scripts/package.mts",
    "test:integration": "node scripts/integration.mts"
  },
  "dependencies": {
    "vscode-languageclient": "^11.0.0"
  },
  "devDependencies": {
    "@plcstudio/language-server": "*",
    "@types/vscode": "~1.100.0",
    "@plcstudio/core": "*",
    "@plcstudio/webviews": "*"
  },
  "activationEvents": [
    "workspaceContains:**/plc.json",
    "workspaceContains:**/*.s7dcl",
    "workspaceContains:**/*.scl"
  ]
}
