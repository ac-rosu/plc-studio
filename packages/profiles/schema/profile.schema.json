{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/ac-rosu/plc-studio/main/packages/profiles/schema/profile.schema.json",
  "title": "PLC Studio version profile",
  "description": "Everything that differs between TIA Portal versions or CPU families, as data. Parameters use a compact signature: \"<in|out|inout> <Name>: <Type>[?]\" where ? marks an optional parameter.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "tiaVersion",
    "extends",
    "elementaryTypes",
    "systemTypes",
    "instructions",
    "ladderElements",
    "systemConstants"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "description": "Profile id, the same as the profile's folder name.",
      "type": "string",
      "pattern": "^V[0-9]+(\\.[0-9]+)?$"
    },
    "tiaVersion": {
      "description": "The TIA Portal version this profile describes.",
      "type": "string",
      "pattern": "^V[0-9]+(\\.[0-9]+)?$"
    },
    "extends": {
      "description": "Id of the profile this one builds on; it then lists only differences. Null for a base profile.",
      "type": ["string", "null"]
    },
    "instructions": {
      "description": "System instructions callable from SCL (functions and function blocks).",
      "type": "array",
      "items": {
        "$ref": "#/definitions/instruction"
      }
    },
    "systemTypes": {
      "description": "System data types: IEC timer/counter instances, edge detectors and system structures.",
      "type": "array",
      "items": {
        "$ref": "#/definitions/systemType"
      }
    },
    "systemConstants": {
      "description": "System constants.",
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "typeRules": {
      "description": "Implicit conversions with the IEC check on and off, literal forms, limits per data type.",
      "type": "object"
    },
    "syntaxFeatures": {
      "description": "Language constructs, pragmas and attributes accepted in SCL, external sources and SIMATIC SD documents.",
      "type": "object"
    },
    "sdFormat": {
      "description": "SIMATIC SD keywords, attribute spellings and resource-file layout.",
      "type": "object"
    },
    "statusInstructions": {
      "description": "Instructions whose return value is a status or error code the caller should evaluate (analyzer rule status-not-evaluated).",
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "failsafe": {
      "description": "Fail-safe catalog: what F-blocks may declare, with the corpus cases that prove it.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "interfaceTypes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["allowed", "forbidden", "arrays", "plcDataTypes", "verification"],
          "properties": {
            "allowed": {
              "description": "Elementary types permitted in F-block interfaces.",
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "forbidden": {
              "description": "Elementary types TIA refuses in F-block interfaces.",
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "arrays": {
              "enum": ["allowed", "forbidden"]
            },
            "plcDataTypes": {
              "enum": ["allowed", "forbidden"]
            },
            "verification": {
              "$ref": "#/definitions/verification"
            }
          }
        }
      }
    },
    "cpuFamilies": {
      "description": "Differences between S7-1200 and S7-1500, including memory and addressing limits.",
      "type": "object"
    },
    "elementaryTypes": {
      "description": "Elementary data types, their class, size and value range.",
      "type": "array",
      "items": {
        "$ref": "#/definitions/elementaryType"
      }
    },
    "ladderElements": {
      "description": "LAD/FBD elements as they are written in SIMATIC SD documents.",
      "type": "array",
      "items": {
        "$ref": "#/definitions/ladderElement"
      }
    }
  },
  "definitions": {
    "cpuFamily": {
      "enum": ["S7-1200", "S7-1500"]
    },
    "verification": {
      "description": "Whether a corpus case compiled in TIA proves this entry. Unverified entries downgrade related diagnostics to warnings.",
      "type": "object",
      "additionalProperties": false,
      "required": ["verified"],
      "properties": {
        "verified": {
          "type": "boolean"
        },
        "cases": {
          "description": "Corpus case ids that use the entry.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "note": {
          "type": "string"
        }
      }
    },
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "direction", "type", "required"],
      "properties": {
        "name": {
          "type": "string"
        },
        "direction": {
          "enum": ["Input", "Output", "InOut"]
        },
        "type": {
          "description": "Data type, or a list of types the parameter accepts.",
          "type": "string"
        },
        "required": {
          "type": "boolean"
        }
      }
    },
    "instruction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "kind",
        "parameters",
        "cpuFamilies",
        "failsafeAllowed",
        "description",
        "verification"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "kind": {
          "enum": ["function", "fb"]
        },
        "parameters": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/signature"
          }
        },
        "returnType": {
          "type": "string"
        },
        "variadic": {
          "description": "More inputs of the same kind may follow (IN3, IN4 ...).",
          "type": "boolean"
        },
        "nonFormal": {
          "description": "May be called with positional arguments, e.g. ABS(#x).",
          "type": "boolean"
        },
        "instanceTypes": {
          "description": "System data types for its instance (FB instructions).",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "cpuFamilies": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/cpuFamily"
          },
          "minItems": 1
        },
        "failsafeAllowed": {
          "type": "boolean"
        },
        "description": {
          "description": "Our own one-line description.",
          "type": "string"
        },
        "helpUrl": {
          "type": "string",
          "pattern": "^https://"
        },
        "verification": {
          "$ref": "#/definitions/verification"
        }
      }
    },
    "systemType": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "kind", "cpuFamilies", "verification"],
      "properties": {
        "name": {
          "type": "string"
        },
        "kind": {
          "enum": ["fb", "struct"]
        },
        "instruction": {
          "description": "Instruction this instance type runs (TON for TON_TIME).",
          "type": "string"
        },
        "parameters": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/signature"
          }
        },
        "members": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*: .+$"
          }
        },
        "description": {
          "type": "string"
        },
        "cpuFamilies": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/cpuFamily"
          },
          "minItems": 1
        },
        "verification": {
          "$ref": "#/definitions/verification"
        }
      }
    },
    "signature": {
      "type": "string",
      "pattern": "^(in|out|inout) [A-Za-z_][A-Za-z0-9_]*: [^?]+[?]?$"
    },
    "elementaryType": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "class", "bits", "cpuFamilies", "verification"],
      "properties": {
        "name": {
          "type": "string"
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "class": {
          "enum": [
            "bool",
            "bit",
            "int",
            "real",
            "time",
            "date",
            "tod",
            "dt",
            "char",
            "string",
            "pointer",
            "void"
          ]
        },
        "bits": {
          "type": "integer",
          "minimum": 0
        },
        "signed": {
          "type": "boolean"
        },
        "min": {
          "type": "string"
        },
        "max": {
          "type": "string"
        },
        "literalPrefixes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "cpuFamilies": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/cpuFamily"
          },
          "minItems": 1
        },
        "verification": {
          "$ref": "#/definitions/verification"
        }
      }
    },
    "ladderElement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "languages", "shape", "parameters", "verification"],
      "properties": {
        "name": {
          "description": "Name as written in .s7dcl (Contact, S_Coil, Move ...).",
          "type": "string"
        },
        "languages": {
          "type": "array",
          "items": {
            "enum": ["LAD", "FBD"]
          },
          "minItems": 1
        },
        "shape": {
          "enum": ["contact", "coil", "box", "jump"]
        },
        "symbol": {
          "description": "Short label drawn in the element.",
          "type": "string"
        },
        "parameters": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/signature"
          }
        },
        "template": {
          "description": "Template attribute that selects the data type (SrcType, time_type ...).",
          "type": "string"
        },
        "typeRequired": {
          "description": "When the box needs an explicit data type (S7_Templates): in every block, or only in fail-safe blocks, where TIA does not choose one automatically.",
          "enum": ["always", "failsafe"]
        },
        "failsafeAllowed": {
          "type": "boolean"
        },
        "failsafeVerification": {
          "description": "Corpus cases that prove failsafeAllowed; without them the flag only gives warnings.",
          "$ref": "#/definitions/verification"
        },
        "description": {
          "type": "string"
        },
        "verification": {
          "$ref": "#/definitions/verification"
        }
      }
    }
  }
}
